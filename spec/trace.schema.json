{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "header": {
      "type": "object",
      "properties": {
        "codewalk": {
          "type": "number",
          "const": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "locs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "const": "block"
                  },
                  "title": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "file": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "parent": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "role",
                  "title",
                  "unit",
                  "file",
                  "start",
                  "end",
                  "parent"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "stmt",
                      "expr"
                    ]
                  },
                  "file": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "parent": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "role",
                  "file",
                  "start",
                  "end",
                  "parent"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "codewalk",
        "sources",
        "locs"
      ],
      "additionalProperties": false
    },
    "event": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "enter"
            },
            "loc": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "op",
            "loc"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "exit"
            },
            "exc": {
              "type": "string"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "out"
            },
            "stream": {
              "type": "string",
              "enum": [
                "stdout",
                "stderr"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "stream",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "value"
            },
            "loc": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "loc",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "ok"
                },
                "op": {
                  "type": "string",
                  "const": "end"
                }
              },
              "required": [
                "status",
                "op"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "truncated"
                },
                "op": {
                  "type": "string",
                  "const": "end"
                }
              },
              "required": [
                "status",
                "op"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "timeout"
                },
                "op": {
                  "type": "string",
                  "const": "end"
                }
              },
              "required": [
                "status",
                "op"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "exception"
                },
                "traceback": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "const": "end"
                }
              },
              "required": [
                "status",
                "traceback",
                "op"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "syntax_error"
                },
                "message": {
                  "type": "string"
                },
                "file": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "op": {
                  "type": "string",
                  "const": "end"
                }
              },
              "required": [
                "status",
                "message",
                "file",
                "start",
                "end",
                "op"
              ],
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/header"
    },
    {
      "$ref": "#/$defs/event"
    }
  ]
}
