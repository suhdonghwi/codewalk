{"codewalk":2,"sources":[{"file":"object_identity.py","text":"from collections import deque, namedtuple\nfrom dataclasses import dataclass\n\nPoint = namedtuple(\"Point\", \"x y\")\n\n\n@dataclass\nclass Node:\n    value: int\n    next: \"Node | None\" = None\n\n\ndef push(stack, item):\n    stack.append(item)\n\n\nshared = []\npair = [shared, shared]\npush(shared, Point(1, 2))\nhead = Node(1, Node(2))\nhead.next.next = head\ncounts = {\"a\": {1, 2}}\nqueue = deque([1, 2])\n"}],"literals":{"list":["[","]"],"tuple":["(",")"],"set":["{","}"],"dict":["{","}"]},"locs":[{"role":"block","file":0,"start":0,"end":385,"parent":null,"title":"object_identity.py","unit":"module"},{"role":"stmt","file":0,"start":0,"end":41,"parent":0},{"role":"stmt","file":0,"start":42,"end":75,"parent":0},{"role":"stmt","file":0,"start":77,"end":111,"parent":0},{"role":"expr","file":0,"start":85,"end":111,"parent":3},{"role":"stmt","file":0,"start":125,"end":136,"parent":0},{"role":"stmt","file":0,"start":141,"end":151,"parent":0},{"role":"stmt","file":0,"start":156,"end":182,"parent":0},{"role":"stmt","file":0,"start":185,"end":207,"parent":0},{"role":"block","file":0,"start":185,"end":230,"parent":8,"title":"push","unit":"call"},{"role":"expr","file":0,"start":194,"end":199,"parent":8},{"role":"expr","file":0,"start":201,"end":205,"parent":8},{"role":"stmt","file":0,"start":212,"end":230,"parent":9},{"role":"expr","file":0,"start":212,"end":230,"parent":12},{"role":"expr","file":0,"start":212,"end":224,"parent":13},{"role":"stmt","file":0,"start":233,"end":244,"parent":0},{"role":"stmt","file":0,"start":245,"end":268,"parent":0},{"role":"stmt","file":0,"start":269,"end":294,"parent":0},{"role":"expr","file":0,"start":269,"end":294,"parent":17},{"role":"expr","file":0,"start":282,"end":293,"parent":18},{"role":"stmt","file":0,"start":295,"end":318,"parent":0},{"role":"expr","file":0,"start":302,"end":318,"parent":20},{"role":"expr","file":0,"start":310,"end":317,"parent":21},{"role":"stmt","fi