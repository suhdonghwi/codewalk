{"codewalk":2,"sources":[{"file":"loop_state.py","text":"def search(items, target):\n    lo, hi = 0, len(items)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if items[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo\n\n\ndef remember(items, item):\n    items.append(item)\n\n\nprint(search([1, 3, 5, 7], 5))\n\nseen = []\nfor word in [\"a\", \"b\", \"a\", \"c\"]:\n    if word not in seen:\n        remember(seen, word)\n\nfor n in [3, 1]:\n    step = 0\n    if n > 1:\n        last = n\n    print(last)\n\nheads = []\ntail = []\nfor i in range(3):\n    if i < 2:\n        heads.append(i)\n    else:\n        tail.append(i)\n\nmisses = 0\nfor even in [2, 4]:\n    if even % 2:\n        misses += 1\nprint(seen, heads, tail)\n"}],"literals":{"list":["[","]"],"tuple":["(",")"],"set":["{","}"],"dict":["{","}"]},"locs":[{"role":"block","file":0,"start":0,"end":675,"parent":null,"title":"loop_state.py","unit":"module"},{"role":"stmt","file":0,"start":0,"end":26,"parent":0},{"role":"block","file":0,"start":0,"end":207,"parent":1,"title":"search","unit":"call"},{"role":"expr","file":0,"start":11,"end":16,"parent":1},{"role":"expr","file":0,"start":18,"end":24,"parent":1},{"role":"stmt","file":0,"start":31,"end":53,"parent":2},{"role":"expr","file":0,"start":43,"end":53,"parent":5},{"role":"stmt","file":0,"start":58,"end":72,"parent":2},{"role":"block","file":0,"start":58,"end":193,"parent":7,"title":"iteration","unit":"iteration","rebinds":["lo","hi"]},{"role":"stmt","file":0,"start":58,"end":72,"parent":8},{"role":"expr","file":0,"start":64,"end":71,"parent":9},{"role":"stmt","file":0,"start":81,"end":101,"parent":8},{"role":"expr","file":0,"start":87,"end":101,"parent":11},{"role":"expr","file":0,"start":88,"end":95,"parent":12},{"role":"stmt","file":0,"start":110,"end":133,"parent":8},{"role":"expr","file":0,"start":113,"end":132,"parent":14},{"role":"expr","file":0,"start":113,"end":123,"parent":15},{"role":"stmt","file":0