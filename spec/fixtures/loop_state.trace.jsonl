{"codewalk":1,"sources":[{"file":"loop_state.py","text":"def search(items, target):\n    lo, hi = 0, len(items)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if items[mid] < target:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo\n\n\nprint(search([1, 3, 5, 7], 5))\n\nseen = []\nfor word in [\"a\", \"b\", \"a\"]:\n    if word not in seen:\n        seen.append(word)\n\nfor n in [3, 1]:\n    if n > 1:\n        last = n\n    print(last)\n"}],"locs":[{"role":"block","file":0,"start":0,"end":396,"parent":null,"title":"loop_state.py","unit":"module"},{"role":"stmt","file":0,"start":0,"end":26,"parent":0},{"role":"block","file":0,"start":0,"end":207,"parent":1,"title":"search","unit":"call"},{"role":"expr","file":0,"start":11,"end":16,"parent":1},{"role":"expr","file":0,"start":18,"end":24,"parent":1},{"role":"stmt","file":0,"start":31,"end":53,"parent":2},{"role":"expr","file":0,"start":43,"end":53,"parent":5},{"role":"stmt","file":0,"start":58,"end":72,"parent":2},{"role":"block","file":0,"start":58,"end":193,"parent":7,"title":"iteration","unit":"iteration"},{"role":"stmt","file":0,"start":58,"end":72,"parent":8},{"role":"expr","file":0,"start":64,"end":71,"parent":9},{"role":"stmt","file":0,"start":81,"end":101,"parent":8},{"role":"expr","file":0,"start":87,"end":101,"parent":11},{"role":"expr","file":0,"start":88,"end":95,"parent":12},{"role":"stmt","file":0,"start":110,"end":133,"parent":8},{"role":"expr","file":0,"start":113,"end":132,"parent":14},{"role":"expr","file":0,"start":113,"end":123,"parent":15},{"role":"stmt","file":0,"start":146,"end":158,"parent":8},{"role":"expr","file":0,"start":151,"end":158,"parent":17},{"role":"stmt","file":0,"start":185,"end":193,"parent":8},{"role":"stmt","file":0,"start":198,"end":207,"parent":2},{"role":"stmt","file":0,"start":210,"end":240,"parent":0},{"role":"expr","file":0,"start":210,"end":240,"parent":21},{"role":"expr","file":0,"start":216,"end":239,"parent":22},{"role":"stmt","f